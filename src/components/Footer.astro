---
const year = new Date().getFullYear();
---

<footer id="faq" class="bg-slate-900 py-12 text-slate-300">
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex flex-col items-start justify-between gap-8 md:flex-row">
      <div>
        <a href={import.meta.env.BASE_URL} class="flex items-center gap-2 text-lg font-bold text-white">
          <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-brand-500 text-sm text-white">W</span>
          WaiverBest
        </a>
        <p class="mt-3 max-w-xs text-sm text-slate-400">
          Digital waivers for gyms, studios, rental shops, and adventure parks.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        <div>
          <p class="text-sm font-semibold text-white">Product</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="#features" class="hover:text-white">Features</a></li>
            <li><a href="#pricing" class="hover:text-white">Pricing</a></li>
          </ul>
        </div>
        <div>
          <p class="text-sm font-semibold text-white">Company</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="#" class="hover:text-white">About</a></li>
            <li><a href="#" class="hover:text-white">Contact</a></li>
          </ul>
        </div>
        <div>
          <p class="text-sm font-semibold text-white">Legal</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="#" class="hover:text-white">Privacy</a></li>
            <li><a href="#" class="hover:text-white">Terms</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-10 border-t border-slate-800 pt-6 text-xs text-slate-500">
      © {year} WaiverBest. All rights reserved.
    </div>
  </div>
</footer>
