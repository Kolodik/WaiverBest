---
const links = [
  { href: "#features", label: "Features" },
  { href: "#how-it-works", label: "How it works" },
  { href: "#pricing", label: "Pricing" },
  { href: "#faq", label: "FAQ" },
];
---

<header class="sticky top-0 z-50 border-b border-brand-100/70 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center gap-2 text-xl font-bold text-brand-700">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-500 text-white">W</span>
      WaiverBest
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {links.map((link) => (
        <a href={link.href} class="text-sm font-medium text-slate-600 transition hover:text-brand-700">
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a href="#" class="hidden text-sm font-semibold text-accent-600 transition hover:text-accent-700 sm:inline">
        Log in
      </a>
      <a
        href="#pricing"
        class="rounded-full bg-accent-500 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-accent-600"
      >
        Start free trial
      </a>
    </div>
  </div>
</header>
