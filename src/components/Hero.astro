---

<section class="relative overflow-hidden bg-gradient-to-b from-brand-50 via-white to-white">
  <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-accent-300/30 blur-3xl"></div>
  <div class="pointer-events-none absolute -left-24 top-40 h-72 w-72 rounded-full bg-teal-300/30 blur-3xl"></div>

  <div class="relative mx-auto grid max-w-6xl gap-12 px-6 py-20 md:grid-cols-2 md:items-center md:py-28">
    <div>
      <span class="inline-flex items-center rounded-full bg-brand-100 px-4 py-1.5 text-sm font-semibold text-brand-700">
        Trusted by gyms, studios &amp; adventure parks
      </span>

      <h1 class="mt-6 text-4xl font-extrabold leading-tight text-slate-900 sm:text-5xl">
        Digital waivers your customers can sign in{" "}
        <span class="text-brand-600">under a minute.</span>
      </h1>

      <p class="mt-6 max-w-xl text-lg text-slate-600">
        WaiverBest replaces paper release forms with a fast, legally sound e-signature
        flow — searchable, storable, and ready the moment you need it for an audit or a claim.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="#pricing"
          class="rounded-full bg-accent-500 px-7 py-3.5 text-base font-bold text-white shadow-md shadow-accent-500/30 transition hover:bg-accent-600"
        >
          Start your free trial
        </a>
        <a
          href="#how-it-works"
          class="rounded-full border border-slate-200 px-7 py-3.5 text-base font-semibold text-slate-700 transition hover:border-brand-300 hover:text-brand-700"
        >
          See how it works
        </a>
      </div>

      <p class="mt-4 text-sm text-slate-500">No credit card required · Cancel anytime</p>
    </div>

    <div class="relative">
      <div class="rounded-3xl border border-slate-100 bg-white p-6 shadow-2xl shadow-slate-900/10">
        <div class="rounded-2xl bg-teal-500 p-6 text-white">
          <p class="text-sm font-semibold uppercase tracking-wide text-teal-100">Liability Waiver</p>
          <p class="mt-1 text-lg font-bold">Riverside Climbing Gym</p>
        </div>
        <div class="mt-6 space-y-4">
          <div class="h-3 w-3/4 rounded-full bg-slate-100"></div>
          <div class="h-3 w-full rounded-full bg-slate-100"></div>
          <div class="h-3 w-5/6 rounded-full bg-slate-100"></div>
          <div class="mt-6 flex items-center justify-between rounded-xl bg-brand-50 p-4">
            <span class="text-sm font-semibold text-brand-700">Signature</span>
            <span class="font-display text-2xl italic text-brand-600">Jack Bigl</span>
          </div>
        </div>
        <button class="mt-6 w-full rounded-xl bg-brand-500 py-3 text-sm font-bold text-white transition hover:bg-brand-600">
          Waiver signed &amp; stored ✓
        </button>
      </div>
    </div>
  </div>
</section>
