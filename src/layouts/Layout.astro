---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "WaiverBest — Digital Waivers, Signed in Seconds",
  description = "Collect legally sound digital waivers from your customers in seconds. No paper, no filing cabinets, no chasing signatures.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-white text-slate-800 antialiased">
    <slot />
  </body>
</html>
